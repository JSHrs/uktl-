{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "uk-talent-link",
  "compatibility_date": "2025-09-24",
  "compatibility_flags": ["nodejs_compat"],
  "main": "@tanstack/react-start/server-entry",

  // D1: leads, candidates, content, analytics, sessions
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "uk-talent-link",
      "database_id": "REPLACE_WITH_D1_DATABASE_ID",
      "migrations_dir": "migrations"
    }
  ],

  // Non-secret runtime variables. Secrets set via `wrangler secret put`:
  //   ANTHROPIC_API_KEY, RESEND_API_KEY, JWT_SECRET, ADMIN_PASSWORD_HASH
  "vars": {
    "ADMIN_EMAIL": "info@uktalentlink.co.uk",
    "FROM_EMAIL": "leads@uktalentlink.co.uk",
    "CLAUDE_MODEL": "claude-sonnet-4-5"
  }
}
