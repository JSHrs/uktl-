{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "tanstack-start-app",
  "compatibility_date": "2025-09-24",
  "compatibility_flags": ["nodejs_compat"],
  "main": "@tanstack/react-start/server-entry",

  // D1: structured candidate & job data
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "talent-compass",
      "database_id": "REPLACE_WITH_D1_DATABASE_ID",
      "migrations_dir": "migrations"
    }
  ],

  // R2: raw CV file storage
  "r2_buckets": [
    {
      "binding": "CV_BUCKET",
      "bucket_name": "talent-compass-cvs"
    }
  ],

  // Workers AI: fallback embedding / extraction if Anthropic key absent
  "ai": {
    "binding": "AI"
  },

  // Runtime variables (non-secret). ANTHROPIC_API_KEY must be set as a
  // secret via `wrangler secret put ANTHROPIC_API_KEY`.
  "vars": {
    "PARSE_PROVIDER": "anthropic",
    "PARSE_MODEL": "claude-sonnet-4-6"
  }
}
